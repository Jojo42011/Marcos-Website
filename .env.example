# ---------------------------------------------------------------------------
# Marco Puga platform — environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# The CRM the intake form feeds. Determines which adapter runs in
# src/lib/crm.ts. Options: "console" (default, logs only — safe for local dev),
# "followupboss", "hubspot", "webhook".
CRM_PROVIDER="console"

# --- Follow Up Boss (if CRM_PROVIDER=followupboss) ---
# FUB_API_KEY=""

# --- HubSpot (if CRM_PROVIDER=hubspot) ---
# HUBSPOT_ACCESS_TOKEN=""

# --- Generic webhook / Zapier / Make (if CRM_PROVIDER=webhook) ---
# CRM_WEBHOOK_URL=""

# Marco's contact number, used to build the click-to-text links.
# Digits only, E.164 without the plus.
PUBLIC_MARCO_SMS="18302689288"

# --- SimplyRETS (live MLS listings: LERA / SABOR feed) ---
# Powers the homepage featured listings, /listings, and listing detail pages.
# Get these from the SimplyRETS dashboard. Server-side only — never exposed
# to the browser. On Vercel, add both under Project Settings → Environment
# Variables. If unset, listings surfaces degrade gracefully (no crash).
SIMPLYRETS_API_KEY=""
SIMPLYRETS_API_SECRET=""
