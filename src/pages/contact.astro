---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { smsHref, SMS_DISPLAY, EMAIL, mailtoHref, OFFICE, telHref, BRAND } from '../config';
---
<Base
  title={`Contact | ${BRAND.name} Real Estate`}
  description="Text Marco directly, or book a quick call. He replies fast, usually within the hour."
>
  <PageHero
    eyebrow="Get in touch"
    title="A Quick Text Is The Easiest Way."
    blurb="It is genuinely how I move fastest, and it is how most of my clients already reach me. Prefer to share a little more first? The short form works too."
    watermark="CONTACT"
  />

  <section class="contact section">
    <div class="container contact__grid">
      <!-- Left: the promise -->
      <div class="contact__left" data-reveal>
        <p class="label">Reach Marco</p>
        <h2 class="contact__title">No Phone Tree. No Assistant. Just Me.</h2>

        <a href={smsHref()} class="contact__text-cta">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
          <span>
            <strong>Text Marco</strong>
            <em>{SMS_DISPLAY}</em>
          </span>
        </a>

        <ul class="contact__promises">
          <li><span>⚡</span> I reply fast, usually within the hour.</li>
          <li><span>🎯</span> A quick call tells us both if it is a good fit.</li>
          <li><span>🤝</span> No pressure and no sales pitch, just straight answers.</li>
        </ul>

        <div class="contact__office">
          <div class="contact__office-rows">
            <div class="contact__office-item">
              <span class="contact__office-label">Email</span>
              <a href={mailtoHref(EMAIL)}>{EMAIL}</a>
            </div>
            <div class="contact__office-item">
              <span class="contact__office-label">Office</span>
              <address>{OFFICE.brokerage}<br />{OFFICE.addressLine1}, {OFFICE.addressLine2}</address>
            </div>
            <div class="contact__office-item">
              <span class="contact__office-label">Office phone</span>
              <a href={telHref(OFFICE.phone)}>{OFFICE.phoneDisplay}</a>
            </div>
            <div class="contact__office-item">
              <span class="contact__office-label">Office email</span>
              <a href={mailtoHref(OFFICE.email)}>{OFFICE.email}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: the form -->
      <div class="contact__right" data-reveal>
        <div class="contact__form-head">
          <h2>Tell me a little about your move</h2>
          <p>Five quick questions so I show up to our call already knowing your situation.</p>
        </div>
        <IntakeForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }

  .contact__title { font-size: var(--step-2); margin-bottom: 1.5rem; text-wrap: balance; }

  .contact__text-cta {
    display: inline-flex; align-items: center; gap: 1rem;
    margin: 0 0 2rem;
    padding: 1.1rem 1.5rem;
    background: var(--obsidian); color: #fff;
    border-radius: 2px;
    transition: transform 0.2s var(--ease);
  }
  .contact__text-cta:hover { transform: translateY(-2px); }
  .contact__text-cta svg { color: #ff6b6b; flex: none; }
  .contact__text-cta strong { display: block; font-size: 1.05rem; }
  .contact__text-cta em { font-style: normal; color: rgba(255,255,255,0.65); font-size: 0.9rem; }

  .contact__promises { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .contact__promises li { display: flex; align-items: center; gap: 0.75rem; color: var(--ink); font-weight: 500; }
  .contact__promises span { font-size: 1.05rem; }

  .contact__office {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .contact__office-rows { display: grid; gap: 1rem; }
  .contact__office-item { display: grid; gap: 0.15rem; }
  .contact__office-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .contact__office-item address {
    font-style: normal;
    color: var(--ink);
    line-height: 1.5;
  }
  .contact__office-item a {
    color: var(--ink);
    font-weight: 500;
    transition: color 0.2s var(--ease);
    word-break: break-word;
  }
  .contact__office-item a:hover { color: var(--crimson); }

  .contact__form-head { margin-bottom: 1.5rem; }
  .contact__form-head h2 { font-size: var(--step-2); margin-bottom: 0.4rem; }
  .contact__form-head p { color: var(--muted); margin: 0; }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
</style>
