---
import Base from '../layouts/Base.astro';
import QuickForm from '../components/QuickForm.astro';
import { smsHref, SMS_DISPLAY, EMAIL, mailtoHref, MARCO_PHONE, MARCO_PHONE_DISPLAY, OFFICE, telHref, BRAND } from '../config';
---
<Base
  title={`Contact | ${BRAND.name} Real Estate`}
  description="Text Marco directly, or send a quick message. He replies fast, usually within the hour."
  solidHeader={true}
>
  <section class="contact">
    <div class="container contact__grid">
      <!-- Left: the promise + text CTA -->
      <div class="contact__left">
        <p class="label">Get in touch</p>
        <h1 class="contact__title">Let&rsquo;s Talk. It&rsquo;s Quick.</h1>
        <p class="contact__lead">
          A text is the fastest way to reach me, and it is how most of my clients already do.
          Prefer to send a few details first? Fill out the form and I will come back with a plan.
        </p>

        <a href={smsHref()} class="contact__text-cta">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
          <span>
            <strong>Text Marco</strong>
            <em>{SMS_DISPLAY}</em>
          </span>
        </a>

        <p class="contact__call">
          Prefer to call? Reach Marco directly at
          <a href={telHref(MARCO_PHONE)}>{MARCO_PHONE_DISPLAY}</a>.
        </p>

        <ul class="contact__promises">
          <li><span>⚡</span> I reply fast, usually within the hour.</li>
          <li><span>🤝</span> No pressure and no sales pitch, just straight answers.</li>
        </ul>
      </div>

      <!-- Right: the quick form -->
      <div class="contact__right">
        <QuickForm />
      </div>
    </div>

    <!-- Office / brokerage details (MLS). Compact strip below the fold. -->
    <div class="container contact__office">
      <div class="contact__office-item">
        <span class="contact__office-label">Email</span>
        <a href={mailtoHref(EMAIL)}>{EMAIL}</a>
      </div>
      <div class="contact__office-item">
        <span class="contact__office-label">Office</span>
        <address>{OFFICE.brokerage}, {OFFICE.addressLine1}, {OFFICE.addressLine2}</address>
      </div>
      <div class="contact__office-item">
        <span class="contact__office-label">Brokerage office</span>
        <a href={telHref(OFFICE.phone)}>{OFFICE.phoneDisplay}</a>
      </div>
      <div class="contact__office-item">
        <span class="contact__office-label">Office email</span>
        <a href={mailtoHref(OFFICE.email)}>{OFFICE.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Top padding clears the fixed header; page opens straight on the form. */
  .contact {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact__title { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; text-wrap: balance; }
  .contact__lead { color: var(--muted); font-size: var(--step-1); margin-bottom: 1.75rem; }

  .contact__text-cta {
    display: inline-flex; align-items: center; gap: 1rem;
    margin: 0 0 1.75rem;
    padding: 1.1rem 1.5rem;
    background: var(--obsidian); color: #fff;
    border-radius: 2px;
    transition: transform 0.2s var(--ease);
  }
  .contact__text-cta:hover { transform: translateY(-2px); }
  .contact__text-cta svg { color: #ff6b6b; flex: none; }
  .contact__text-cta strong { display: block; font-size: 1.05rem; }
  .contact__text-cta em { font-style: normal; color: rgba(255,255,255,0.65); font-size: 0.9rem; }

  .contact__call {
    margin: 0 0 1.75rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .contact__call a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: 1px solid var(--crimson);
    transition: color 0.2s var(--ease);
  }
  .contact__call a:hover { color: var(--crimson); }

  .contact__promises { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .contact__promises li { display: flex; align-items: center; gap: 0.75rem; color: var(--ink); font-weight: 500; }
  .contact__promises span { font-size: 1.05rem; }

  /* Office strip */
  .contact__office {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .contact__office-item { display: grid; gap: 0.25rem; align-content: start; }
  .contact__office-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .contact__office-item address { font-style: normal; color: var(--ink); line-height: 1.5; font-size: 0.95rem; }
  .contact__office-item a {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s var(--ease);
    word-break: break-word;
  }
  .contact__office-item a:hover { color: var(--crimson); }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; align-items: start; }
    .contact__office { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .contact__office { grid-template-columns: 1fr; }
  }
</style>
