---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { smsHref, BRAND } from '../config';

const steps = [
  { n: '01', t: 'The first call', d: 'A quick, no pressure conversation to understand your situation. Your budget, your timeline, and why you are moving. In a few minutes we both know whether it is a good fit.' },
  { n: '02', t: 'Get clear on what you want', d: 'We talk through your must haves and your nice to haves, then I start sending real homes that fit. No firehose of every listing on the market.' },
  { n: '03', t: 'Tour homes with honest feedback', d: 'We walk homes together and I give you a straight read on every one. If a place is overpriced or the area is wrong for your family, you will hear it.' },
  { n: '04', t: 'Offer strategy and negotiation', d: 'Once we find the right one, I handle the offer and the negotiation for you. This is where I earn my keep, structuring things to win without overpaying.' },
  { n: '05', t: 'Inspections and repairs', d: 'I walk you through inspections and push for the repairs that matter, so surprises do not become your problem after you move in.' },
  { n: '06', t: 'All the way to the keys', d: 'I stay on top of the lender and title company so nothing slips, and I keep you in the loop the whole way through closing.' },
];

const markets = [
  { city: 'San Antonio and suburbs', tag: 'Home base', d: 'First time buyers in the $250k to $450k range, and growing families moving up into $700k to $1.2M single family homes and new construction.' },
  { city: 'Miami, Florida', tag: 'Active and growing', d: 'Premium condos and luxury single family homes from $500k to $1.5M, with a trusted local partner on the ground for showings and paperwork.' },
];
---
<Base
  title={`Buyers | ${BRAND.name} Real Estate`}
  description="A patient, responsive buying experience across San Antonio and Miami. Honest feedback on every home and confident negotiation from the first call to the keys."
>
  <PageHero
    eyebrow="For Buyers"
    title="Someone in your corner from day one"
    blurb="Quick replies, honest feedback on every home, and negotiation that protects your money. Here is exactly how it goes from the first hello to the keys in your hand."
  />

  <!-- BLUEPRINT TIMELINE -->
  <section class="section blueprint">
    <div class="container">
      <div class="blueprint__head" data-reveal>
        <p class="eyebrow">How buying works</p>
        <h2>No mystery, and no disappearing after the first meeting</h2>
      </div>
      <ol class="timeline">
        {steps.map((s, i) => (
          <li class="tl" data-reveal style={`--i:${i}`}>
            <span class="tl__num">{s.n}</span>
            <div class="tl__body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- MARKET SNAPSHOT -->
  <section class="section markets">
    <div class="container">
      <div class="markets__head" data-reveal>
        <p class="eyebrow">Where I work</p>
        <h2>Two markets, one standard</h2>
      </div>
      <div class="markets__grid">
        {markets.map((m, i) => (
          <article class="market" data-reveal style={`--i:${i}`}>
            <span class="market__tag">{m.tag}</span>
            <h3>{m.city}</h3>
            <p>{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section buyers-cta">
    <div class="container container--tight buyers-cta__inner" data-reveal>
      <h2>Tell me what you are looking for</h2>
      <p>Send me a quick text with your price range, the areas you like, and your timeline. I will come back with real options.</p>
      <div class="buyers-cta__buttons">
        <Button href={smsHref('Hi Marco, I am looking to buy. Here is what I have in mind: ')} variant="primary" dataSms={true}>Text Marco</Button>
        <Button href="/contact" variant="outline">Book a call</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .blueprint__head, .markets__head { max-width: 640px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .tl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i) * 60ms);
  }
  .tl:last-child { border-bottom: 1px solid var(--line); }
  .tl__num {
    font-family: var(--font-head); font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    color: var(--crimson);
    line-height: 1;
    min-width: 2.4ch;
  }
  .tl__body h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .tl__body p { color: var(--muted); margin: 0; max-width: 64ch; }

  .markets { background: var(--gray-light); }
  .markets__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 1.75rem); }
  .market {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 3px solid var(--crimson);
    transition-delay: calc(var(--i) * 90ms);
  }
  .market__tag {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--crimson); margin-bottom: 0.75rem;
  }
  .market h3 { font-size: var(--step-2); margin: 0 0 0.6rem; }
  .market p { color: var(--muted); margin: 0; }

  .buyers-cta { text-align: center; }
  .buyers-cta h2 { font-size: var(--step-3); }
  .buyers-cta p { color: var(--muted); font-size: var(--step-1); margin-bottom: 2rem; max-width: 54ch; margin-inline: auto; }
  .buyers-cta__buttons { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 720px) {
    .markets__grid { grid-template-columns: 1fr; }
    .tl { gap: 1rem; }
  }
</style>
