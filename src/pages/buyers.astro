---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { smsHref, BRAND } from '../config';

const steps = [
  { n: '01', t: 'The 15-minute triage call', d: "A quick, no-pressure call to understand your situation — budget, timeline, why you're moving. It tells us both in fifteen minutes whether this is a fit." },
  { n: '02', t: 'Dial in what you actually want', d: 'We go deeper on the must-haves vs. the nice-to-haves, then I start sending real listings that fit — not a firehose of everything on the market.' },
  { n: '03', t: 'Tour with honest feedback', d: "We walk homes together and I tell you the truth on every one. If it's overpriced or the neighborhood's wrong, you'll hear it — not hype." },
  { n: '04', t: 'Offer strategy & negotiation', d: 'Once we find the one, I handle the offer and negotiation myself — structured to win without overpaying. This is where I earn my keep.' },
  { n: '05', t: 'Inspections & repair requests', d: "I walk you through inspections and push for the repairs that matter, so surprises don't become your problem after closing." },
  { n: '06', t: 'Closing protection', d: 'I stay on top of the lender and title company so nothing falls through the cracks — and I check in constantly right through the keys.' },
];

const markets = [
  { city: 'San Antonio & suburbs', tag: 'Primary market', d: 'First-time buyers in the $250k–$450k range and move-up buyers into $700k–$1.2M single-family and new construction.' },
  { city: 'Miami, FL', tag: 'Active & expanding', d: 'Premium condos and luxury single-family from $500k–$1.5M, with a trusted boots-on-the-ground partner for showings and paperwork.' },
];
---
<Base
  title={`Buyers — ${BRAND.name}`}
  description="A protective, hyper-responsive buyer experience across San Antonio and Miami. Honest feedback on every home and sharp negotiation from first call to keys."
  headerTone="dark"
>
  <PageHero
    eyebrow="The Buyer Experience"
    title="A partner in your corner — not a door-unlocker."
    blurb="Fast texts, unfiltered truth on every home, and negotiation that protects your money. Here's exactly how it goes from first hello to keys in hand."
  />

  <!-- BLUEPRINT TIMELINE -->
  <section class="section blueprint">
    <div class="container">
      <div class="blueprint__head" data-reveal>
        <p class="eyebrow">The step-by-step blueprint</p>
        <h2>No mystery. No ghosting after the first meeting.</h2>
      </div>
      <ol class="timeline">
        {steps.map((s, i) => (
          <li class="tl" data-reveal style={`--i:${i}`}>
            <span class="tl__num">{s.n}</span>
            <div class="tl__body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- MARKET SNAPSHOT -->
  <section class="section markets">
    <div class="container">
      <div class="markets__head" data-reveal>
        <p class="eyebrow">Where I work</p>
        <h2>Two markets. One standard.</h2>
      </div>
      <div class="markets__grid">
        {markets.map((m, i) => (
          <article class="market" data-reveal style={`--i:${i}`}>
            <span class="market__tag">{m.tag}</span>
            <h3>{m.city}</h3>
            <p>{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section buyers-cta">
    <div class="container container--tight buyers-cta__inner" data-reveal>
      <h2>Tell me what you're looking for.</h2>
      <p>Text me your criteria — price, area, timeline — and I'll come back with real options, fast.</p>
      <div class="buyers-cta__buttons">
        <Button href={smsHref("Hey Marco — I'm buying. Here's what I'm looking for: ")} variant="primary" dataSms={true}>Text Marco your criteria</Button>
        <Button href="/contact" variant="outline">Start with the 15-min call</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .blueprint__head, .markets__head { max-width: 620px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .tl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i) * 60ms);
  }
  .tl:last-child { border-bottom: 1px solid var(--line); }
  .tl__num {
    font-family: var(--font-head); font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    color: var(--crimson);
    line-height: 1;
    min-width: 2.4ch;
  }
  .tl__body h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .tl__body p { color: var(--muted); margin: 0; max-width: 62ch; }

  .markets { background: var(--gray-light); }
  .markets__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 1.75rem); }
  .market {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 3px solid var(--crimson);
    transition-delay: calc(var(--i) * 90ms);
  }
  .market__tag {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--crimson); margin-bottom: 0.75rem;
  }
  .market h3 { font-size: var(--step-2); margin: 0 0 0.6rem; }
  .market p { color: var(--muted); margin: 0; }

  .buyers-cta { text-align: center; }
  .buyers-cta h2 { font-size: var(--step-3); }
  .buyers-cta p { color: var(--muted); font-size: var(--step-1); margin-bottom: 2rem; }
  .buyers-cta__buttons { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 720px) {
    .markets__grid { grid-template-columns: 1fr; }
    .tl { gap: 1rem; }
  }
</style>
