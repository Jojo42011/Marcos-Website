---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { smsHref, BRAND } from '../config';

const marketing = [
  { t: 'Presented properly', d: 'Professional photography and a clean, honest presentation that shows your home at its best and reaches serious buyers, not just whoever happens to be looking that week.' },
  { t: 'Priced with a straight read', d: 'A clear, realistic price backed by real numbers. I will tell you what your home is truly worth, even when it is not the highest figure you hoped to hear.' },
  { t: 'Negotiated with care', d: 'Calm, confident negotiation that protects your bottom line. My job is to get you the best possible price and terms, and to keep the process from falling apart.' },
];

const valuation = [
  'What you own and where, and the details that actually move the number.',
  'Your timeline and why you are selling, so the plan fits your life.',
  'A straight read on pricing, including whether now is the right time.',
  'A marketing plan built around real exposure, not a sign in the yard and hope.',
];
---
<Base
  title={`Sellers | ${BRAND.name} Real Estate`}
  description="A thoughtful seller strategy built on honest pricing, professional marketing, and confident negotiation. A real valuation, not a gimmicky instant estimate."
>
  <PageHero
    eyebrow="For Sellers"
    title="Your Home Deserves A Real Plan."
    blurb="Honest pricing, professional marketing, and steady negotiation, all aimed at getting your home in front of the right buyers and earning you the best possible price."
    watermark="SELLERS"
  />

  <!-- MARKETING APPROACH -->
  <section class="section multiplier">
    <div class="container">
      <div class="multiplier__head" data-reveal>
        <p class="label">How I market your home</p>
        <h2>Thoughtful marketing, not guesswork</h2>
        <p class="multiplier__lead">
          Selling well is not about a sign in the yard and waiting. It is about presenting your home
          properly, pricing it honestly, and negotiating with care, so the right buyers show up and
          compete for it. That is how you land a strong price.
        </p>
      </div>
      <div class="multiplier__grid">
        {marketing.map((m, i) => (
          <article class="mult" data-reveal style={`--i:${i}`}>
            <span class="mult__bar" aria-hidden="true"></span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUATION INTAKE -->
  <section class="section valuation">
    <div class="container valuation__grid">
      <div class="valuation__copy" data-reveal>
        <p class="label label--dark">What is my home worth</p>
        <h2>A real answer, not a guess from an algorithm</h2>
        <p>
          Not an automated number from a website that has never seen your street. A real,
          thoughtful read on your home’s value and the smartest way to bring it to market,
          built around your timeline and your goals.
        </p>
        <ul class="valuation__list">
          {valuation.map((v) => (
            <li>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>{v}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="valuation__card" data-reveal>
        <h3>Ask about your home’s value</h3>
        <p>The easiest way to start is a text. Send me your address and your timeline, and I will come back with a real plan, not a canned estimate.</p>
        <Button href={smsHref('Hi Marco, I am thinking about selling. My address is ')} variant="primary" dataSms={true} class="valuation__btn">Text Marco</Button>
        <a href="/contact" class="valuation__alt">Prefer to share more detail first? Use the contact form</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .multiplier__head { max-width: 680px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .multiplier__lead { color: var(--muted); font-size: var(--step-1); margin: 0; }
  .multiplier__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 1.75rem); }
  .mult {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i) * 90ms);
  }
  .mult__bar { display: block; width: 40px; height: 3px; background: var(--crimson); margin-bottom: 1.25rem; }
  .mult h3 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .mult p { color: var(--muted); margin: 0; }

  .valuation { background: var(--obsidian); color: #fff; }
  .valuation__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .valuation__copy h2 { font-size: var(--step-2); }
  .valuation__copy > p { color: rgba(255,255,255,0.7); font-size: var(--step-1); }
  .valuation__list { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 0.9rem; }
  .valuation__list li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; }
  .valuation__list svg { color: var(--crimson); margin-top: 2px; }
  .valuation__list span { color: rgba(255,255,255,0.85); }

  .valuation__card {
    background: #111113;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 3px solid var(--crimson);
  }
  .valuation__card h3 { font-size: var(--step-1); }
  .valuation__card p { color: rgba(255,255,255,0.65); }
  .valuation__btn { width: 100%; margin-top: 0.5rem; }
  .valuation__alt { display: inline-block; margin-top: 1.25rem; font-size: 0.9rem; color: rgba(255,255,255,0.6); }
  .valuation__alt:hover { color: #fff; }

  @media (max-width: 820px) {
    .multiplier__grid { grid-template-columns: 1fr; }
    .valuation__grid { grid-template-columns: 1fr; }
  }
</style>
