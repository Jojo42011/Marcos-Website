---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { smsHref, BRAND } from '../config';

const values = [
  { t: 'I tell you the truth', d: "Even when it costs me the deal. Overpriced house, wrong neighborhood, bad timing — you'll hear it straight." },
  { t: "I don't disappear", d: 'Fast texts and calls back, even at odd hours. Most of my business comes from people I\'ve already closed for — that only happens if you stay.' },
  { t: 'You already know me', d: "A lot of clients feel like they know me before we ever talk, from the content. That trust is the whole head start." },
];

// SWAP POINT: candid closing/showing photos → /public/photos/*.jpg
const shots = [
  'Closing day handoff',
  'Walkthrough, luxury listing',
  'On-site with clients',
  'Keys to a first home',
];
---
<Base
  title={`About — ${BRAND.name}`}
  description="From first-time buyers to million-dollar closings — Marco Puga's story, and why clients say he's on their side, not just trying to close them."
  headerTone="dark"
>
  <PageHero
    eyebrow="The Track Record"
    title="Legit, active, and genuinely on your side."
    blurb="Closing million-dollar deals without ever losing the thing that got me here — actually looking out for the people I work with."
  />

  <!-- STORY -->
  <section class="section story">
    <div class="container story__grid">
      <div class="story__copy" data-reveal>
        <p class="eyebrow">The short version</p>
        <p class="story__lead">
          I started by helping everyday families in San Antonio find their first homes — and I still love that work.
          As the referrals grew, so did the deals: $700k, then $1M, now $1.2M+.
        </p>
        <p>
          But I never wanted to become the stuffy, unapproachable luxury-only agent. The luxury side is proof of
          how far I've come — not the whole identity. Whether it's a $300k starter home or a million-dollar listing,
          you get the same thing: someone who tells you the truth, moves fast, and treats your money like it's mine.
        </p>
        <p>
          These days that means two markets — a busy San Antonio base and an active, growing presence in Miami,
          where I work alongside a trusted local partner so my clients get real infrastructure on the ground
          plus my strategy and negotiation.
        </p>
      </div>

      <div class="story__gallery" data-reveal>
        {shots.map((label, i) => (
          <figure class="shot" style={`--i:${i}`}>
            <div class="shot__ph" aria-hidden="true"><span>MP</span></div>
            <figcaption>{label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section values">
    <div class="container">
      <div class="values__head" data-reveal>
        <p class="eyebrow">What clients actually say</p>
        <h2>The stuff other agents can't fake.</h2>
      </div>
      <div class="values__grid">
        {values.map((v, i) => (
          <article class="value" data-reveal style={`--i:${i}`}>
            <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section about-cta">
    <div class="container container--tight about-cta__inner" data-reveal>
      <h2>Let's talk.</h2>
      <p>The fastest way to reach me is a text — same as everyone else. No phone tree, no assistant. Just me.</p>
      <Button href={smsHref("Hey Marco — ")} variant="primary" dataSms={true}>Connect direct via text</Button>
    </div>
  </section>
</Base>

<style>
  .story__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .story__lead { font-family: var(--font-head); font-size: var(--step-2); line-height: 1.25; color: var(--ink); }
  .story__copy p:not(.story__lead) { color: var(--muted); }

  .story__gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .shot { margin: 0; }
  .shot__ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    display: grid; place-items: center;
    background: radial-gradient(120% 100% at 30% 0%, #1a1a1d, #050506);
    position: relative; overflow: hidden;
  }
  .shot:nth-child(even) .shot__ph { aspect-ratio: 4 / 5; transform: translateY(1.5rem); }
  .shot__ph span {
    font-family: var(--font-head); font-weight: 700; font-size: 1.5rem;
    color: rgba(255,255,255,0.25);
    border: 1.5px solid rgba(255,255,255,0.18); border-radius: 5px; padding: 0.3em 0.5em;
  }
  .shot figcaption { margin-top: 0.6rem; font-size: 0.82rem; color: var(--muted); }
  .shot:nth-child(even) figcaption { transform: translateY(1.5rem); }

  .values { background: var(--gray-light); }
  .values__head { max-width: 560px; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .values__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 1.75rem); }
  .value {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition-delay: calc(var(--i) * 90ms);
  }
  .value__num { font-family: var(--font-head); font-weight: 700; color: var(--crimson); font-size: 1rem; }
  .value h3 { font-size: var(--step-1); margin: 0.4rem 0 0.5rem; }
  .value p { color: var(--muted); margin: 0; }

  .about-cta { text-align: center; }
  .about-cta h2 { font-size: var(--step-3); }
  .about-cta p { color: var(--muted); font-size: var(--step-1); margin-bottom: 2rem; }

  @media (max-width: 820px) {
    .story__grid { grid-template-columns: 1fr; }
    .values__grid { grid-template-columns: 1fr; }
    .shot:nth-child(even) .shot__ph,
    .shot:nth-child(even) figcaption { transform: none; }
  }
</style>
