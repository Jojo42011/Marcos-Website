---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { smsHref, BRAND } from '../config';

const values = [
  { t: 'I tell you the truth', d: 'Even when it is not what you want to hear. Overpriced home, wrong neighborhood, wrong timing. You will always get a straight answer from me.' },
  { t: 'I stay in it with you', d: 'Fast replies and real follow through, not a disappearing act after the first meeting. Most of my business comes from past clients and their referrals, and that only happens if I show up.' },
  { t: 'I keep it calm', d: 'Buying or selling a home is stressful enough. My job is to make it feel steady and clear, so you can make good decisions without the pressure.' },
];

// SWAP POINT: candid closing and showing photos -> /public/photos/*.jpg
const shots = [
  'Closing day',
  'A luxury walkthrough',
  'On site with clients',
  'Keys to a first home',
];
---
<Base
  title={`About | ${BRAND.name} Real Estate`}
  description="From first time buyers to million dollar closings. Marco Puga’s story, and why clients say he is genuinely on their side."
>
  <PageHero
    eyebrow="About Marco"
    title="Honest, steady, and genuinely on your side"
    blurb="Closing bigger deals every year without ever losing the thing that got me here, actually looking out for the families I work with."
  />

  <!-- STORY -->
  <section class="section story">
    <div class="container story__grid">
      <div class="story__copy" data-reveal>
        <p class="eyebrow">The short version</p>
        <p class="story__lead">
          I started out helping everyday families in San Antonio find their first homes, and I
          still love that work. As the referrals grew, so did the deals, all the way up to luxury
          listings above a million dollars.
        </p>
        <p>
          I never wanted to become the stiff, unapproachable luxury agent. The higher end work is
          proof of how far I have come, not the whole story. Whether it is a first home or a
          million dollar listing, you get the same thing from me. Someone who tells you the truth,
          moves quickly, and treats your money like it is my own.
        </p>
        <p>
          These days that means two markets. A busy base in San Antonio and an active, growing
          presence in Miami, where I work alongside a trusted local partner so my clients get real
          support on the ground plus my strategy and negotiation.
        </p>
      </div>

      <div class="story__gallery" data-reveal>
        {shots.map((label, i) => (
          <figure class="shot" style={`--i:${i}`}>
            <div class="shot__ph" aria-hidden="true"><span>Marco Puga</span></div>
            <figcaption>{label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section values">
    <div class="container">
      <div class="values__head" data-reveal>
        <p class="eyebrow">What you can count on</p>
        <h2>The things that actually matter</h2>
      </div>
      <div class="values__grid">
        {values.map((v, i) => (
          <article class="value" data-reveal style={`--i:${i}`}>
            <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section about-cta">
    <div class="container container--tight about-cta__inner" data-reveal>
      <h2>Let’s talk</h2>
      <p>The easiest way to reach me is a text. No phone tree, no assistant, just me.</p>
      <Button href={smsHref('Hi Marco, ')} variant="primary" dataSms={true}>Text Marco</Button>
    </div>
  </section>
</Base>

<style>
  .story__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .story__lead { font-family: var(--font-head); font-size: var(--step-2); line-height: 1.25; color: var(--ink); }
  .story__copy p:not(.story__lead) { color: var(--muted); }

  .story__gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .shot { margin: 0; }
  .shot__ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    display: grid; place-items: center;
    background: radial-gradient(120% 100% at 30% 0%, #1a1a1d, #050506);
    position: relative; overflow: hidden;
  }
  .shot:nth-child(even) .shot__ph { transform: translateY(1.5rem); }
  .shot__ph span {
    font-family: var(--font-head); font-weight: 600; font-size: 1rem;
    color: rgba(255,255,255,0.26);
  }
  .shot figcaption { margin-top: 0.6rem; font-size: 0.82rem; color: var(--muted); }
  .shot:nth-child(even) figcaption { transform: translateY(1.5rem); }

  .values { background: var(--gray-light); }
  .values__head { max-width: 560px; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .values__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 1.75rem); }
  .value {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition-delay: calc(var(--i) * 90ms);
  }
  .value__num { font-family: var(--font-head); font-weight: 700; color: var(--crimson); font-size: 1rem; }
  .value h3 { font-size: var(--step-1); margin: 0.4rem 0 0.5rem; }
  .value p { color: var(--muted); margin: 0; }

  .about-cta { text-align: center; }
  .about-cta h2 { font-size: var(--step-3); }
  .about-cta p { color: var(--muted); font-size: var(--step-1); margin-bottom: 2rem; }

  @media (max-width: 820px) {
    .story__grid { grid-template-columns: 1fr; }
    .values__grid { grid-template-columns: 1fr; }
    .shot:nth-child(even) .shot__ph,
    .shot:nth-child(even) figcaption { transform: none; }
  }
</style>
