---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import WorkWith from '../components/WorkWith.astro';
import Areas from '../components/Areas.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedListings from '../components/FeaturedListings.astro';
import { smsHref } from '../config';
---
<Base>
  <!-- 1. Full screen slideshow hero -->
  <HeroSlideshow />

  <!-- 2. About Marco -->
  <AboutTeaser />

  <!-- 3. Work with Marco: buy or sell -->
  <WorkWith />

  <!-- 4. Areas we serve: Texas to Miami -->
  <Areas />

  <!-- 5. Client reviews -->
  <Reviews />

  <!-- 6. Featured listings -->
  <FeaturedListings />

  <!-- 7. Closing CTA -->
  <section class="cta-band section">
    <div class="container cta-band__inner" data-reveal>
      <p class="label label--center label--dark">Ready when you are</p>
      <h2>Your Next Address Is Waiting.</h2>
      <p class="cta-band__text">A quick text is the easiest way to reach me. Tell me what you are thinking about and we will take it from there, no pressure.</p>
      <div class="cta-band__buttons">
        <Button href={smsHref()} variant="primary" dataSms={true}>Text Marco</Button>
        <Button href="/contact" variant="outline" tone="light">Contact Marco</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-band { background: var(--obsidian); color: #fff; text-align: center; }
  .cta-band__inner { max-width: 680px; margin-inline: auto; }
  .cta-band h2 { font-size: var(--step-3); }
  .cta-band__text { color: rgba(255,255,255,0.72); font-size: var(--step-1); margin-bottom: 2.25rem; }
  .cta-band__buttons { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }
</style>
