---
// Premium image gallery. A calm, editorial grid of real photography:
// listings, closings, and Marco at work. Placeholders ship here now with
// clearly labeled SWAP POINTs so real images drop in with no layout change.
//
// SWAP POINT: add photos to /public/photos/ and set `src` on each item below.
export interface GalleryItem {
  label: string;
  src?: string;     // e.g. '/photos/stone-oak-living.jpg'
  span?: 'tall' | 'wide' | 'normal';
}
interface Props {
  items?: GalleryItem[];
  heading?: string;
  eyebrow?: string;
  blurb?: string;
}
const {
  items = [
    { label: 'Recent listing, Stone Oak', span: 'tall' },
    { label: 'Closing day', span: 'normal' },
    { label: 'A family’s first home', span: 'normal' },
    { label: 'Luxury single family, San Antonio', span: 'wide' },
    { label: 'Condo tour, Miami', span: 'normal' },
    { label: 'Handing over the keys', span: 'normal' },
  ],
  heading = 'A look at the work',
  eyebrow = 'Recent homes',
  blurb = 'Real homes, real families, real closings. A calm, honest look at the moves I help people make across San Antonio and Miami.',
} = Astro.props;
---
<section class="gallery section" aria-labelledby="gallery-h">
  <div class="container">
    <div class="gallery__head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="gallery-h">{heading}</h2>
      <p class="gallery__blurb">{blurb}</p>
    </div>

    <div class="gallery__grid">
      {items.map((item, i) => (
        <figure class={`gcard gcard--${item.span ?? 'normal'}`} data-reveal style={`--i:${i}`}>
          {item.src ? (
            <img src={item.src} alt={item.label} loading="lazy" class="gcard__img" />
          ) : (
            <div class="gcard__ph" aria-hidden="true"><span>Marco Puga</span></div>
          )}
          <figcaption class="gcard__cap">{item.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--gray-light); }
  .gallery__head { max-width: 640px; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .gallery__blurb { color: var(--muted); font-size: var(--step-1); margin: 0; }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 240px;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .gcard { margin: 0; position: relative; transition-delay: calc(var(--i) * 70ms); }
  .gcard--tall { grid-row: span 2; }
  .gcard--wide { grid-column: span 2; }

  .gcard__img,
  .gcard__ph {
    width: 100%; height: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
    overflow: hidden;
  }
  .gcard__ph {
    display: grid; place-items: center;
    background:
      radial-gradient(120% 100% at 30% 0%, #1a1a1d 0%, #050506 70%);
    position: relative;
  }
  .gcard__ph::after {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent);
  }
  .gcard__ph span {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: rgba(255,255,255,0.28);
  }
  .gcard__cap {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1rem 1.1rem;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  @media (max-width: 820px) {
    .gallery__grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 190px; }
    .gcard--wide { grid-column: span 2; }
    .gcard--tall { grid-row: span 1; }
  }
  @media (max-width: 460px) {
    .gallery__grid { grid-template-columns: 1fr; grid-auto-rows: 220px; }
    .gcard--wide { grid-column: span 1; }
  }
</style>
