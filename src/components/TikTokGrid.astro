---
// Curated TikTok proof grid using a "facade" pattern:
// each card renders as a lightweight poster (no iframe) until tapped, then
// swaps in the real TikTok embed. Keeps the page instant on mobile.
//
// SWAP POINT: replace each `videoId` with a real TikTok video ID and drop a
// poster image into /public/tiktok/. Until then, cards show a branded
// placeholder so the layout is final and demo-ready.
export interface TikTokCard {
  videoId: string;      // e.g. '7300000000000000000'
  label: string;        // short caption under the card
  poster?: string;      // optional /tiktok/xyz.jpg
}
interface Props {
  cards?: TikTokCard[];
  heading?: string;
  eyebrow?: string;
  blurb?: string;
}
const {
  cards = [
    { videoId: '', label: 'Luxury walkthrough — Stone Oak' },
    { videoId: '', label: 'Miami condo tour — Brickell' },
    { videoId: '', label: 'Straight-talk market update' },
    { videoId: '', label: 'Behind the scenes at closing' },
  ],
  heading = 'Proof, not promises.',
  eyebrow = 'Straight from the feed',
  blurb = "The same no-BS walkthroughs and market takes you already know from TikTok — the reason most clients feel like they know me before we ever talk.",
} = Astro.props;
---
<section class="tiktok section" aria-labelledby="tiktok-h">
  <div class="container">
    <div class="tiktok__head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="tiktok-h">{heading}</h2>
      <p class="tiktok__blurb">{blurb}</p>
    </div>

    <div class="tiktok__grid">
      {cards.map((card, i) => (
        <figure class="tt-card" data-reveal style={`--i:${i}`}>
          <button
            class="tt-card__frame"
            data-tt-embed
            data-video-id={card.videoId}
            aria-label={`Play TikTok: ${card.label}`}
            style={card.poster ? `background-image:url(${card.poster})` : undefined}
          >
            {!card.poster && (
              <span class="tt-card__placeholder" aria-hidden="true">
                <span class="tt-card__mono">MP</span>
              </span>
            )}
            <span class="tt-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
          <figcaption class="tt-card__cap">{card.label}</figcaption>
        </figure>
      ))}
    </div>

    <p class="tiktok__more">
      <a href="https://www.tiktok.com/@marcopuga" rel="noopener" class="tiktok__morelink">
        See more on TikTok
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </p>
  </div>
</section>

<style>
  .tiktok { background: var(--gray-light); }
  .tiktok__head { max-width: 640px; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .tiktok__blurb { color: var(--muted); font-size: var(--step-1); margin: 0; }

  .tiktok__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .tt-card { margin: 0; transition-delay: calc(var(--i) * 70ms); }

  .tt-card__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--obsidian) center / cover no-repeat;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .tt-card__frame:hover { transform: translateY(-4px); box-shadow: 0 18px 44px rgba(0, 0, 0, 0.2); }

  .tt-card__placeholder {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    background:
      radial-gradient(120% 80% at 50% 0%, #1a1a1d 0%, #000 70%);
  }
  .tt-card__placeholder::after {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent);
  }
  .tt-card__mono {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 2.4rem;
    color: rgba(255, 255, 255, 0.9);
    border: 2px solid rgba(255,255,255,0.25);
    border-radius: 6px;
    padding: 0.35em 0.5em;
  }
  .tt-card__mono { position: relative; }

  .tt-card__play {
    position: absolute;
    left: 50%; bottom: 14px;
    transform: translateX(-50%);
    width: 52px; height: 52px;
    display: grid; place-items: center;
    background: var(--crimson);
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgba(153, 0, 0, 0.5);
  }
  .tt-card__cap {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }

  .tiktok__more { margin-top: clamp(2rem, 4vw, 3rem); }
  .tiktok__morelink {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: 600; color: var(--crimson);
  }
  .tiktok__morelink:hover { gap: 0.75rem; transition: gap 0.25s var(--ease); }

  @media (max-width: 900px) { .tiktok__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .tiktok__grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; } }
</style>

<script>
  // Facade → real embed. Only loads TikTok's script on first interaction.
  let scriptLoaded = false;
  const ensureScript = () => {
    if (scriptLoaded) return;
    scriptLoaded = true;
    const s = document.createElement('script');
    s.src = 'https://www.tiktok.com/embed.js';
    s.async = true;
    document.body.appendChild(s);
  };

  document.querySelectorAll('[data-tt-embed]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-video-id');
      // No real ID wired yet → send to profile so the CTA still works in demo.
      if (!id) {
        window.open('https://www.tiktok.com/@marcopuga', '_blank', 'noopener');
        return;
      }
      const wrap = document.createElement('blockquote');
      wrap.className = 'tiktok-embed';
      wrap.setAttribute('cite', `https://www.tiktok.com/@marcopuga/video/${id}`);
      wrap.setAttribute('data-video-id', id);
      wrap.style.margin = '0';
      const inner = document.createElement('section');
      wrap.appendChild(inner);
      btn.replaceWith(wrap);
      ensureScript();
    });
  });
</script>
