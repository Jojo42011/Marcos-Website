---
// Marco Puga's real brand logo (the house/diamond emblem + wordmark).
// Two prepared variants of the same logo:
//   - /brand/logo.png       original colors (red emblem, dark text) for LIGHT backgrounds
//   - /brand/logo-light.png white text + red emblem, for DARK backgrounds
// Set `onDark` when the logo sits on a dark surface (footer).
interface Props {
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className = '' } = Astro.props;
const src = onDark ? '/brand/logo-light.png' : '/brand/logo.png';
---
<a href="/" class={`logo ${className}`} aria-label="Marco Puga Real Estate, home">
  <img src={src} alt="Marco Puga Real Estate" class="logo__img" width="215" height="210" />
</a>

<style>
  .logo { display: inline-flex; align-items: center; line-height: 0; }
  .logo__img {
    height: 72px;
    width: auto;
    display: block;
  }
  @media (max-width: 820px) {
    .logo__img { height: 58px; }
  }
</style>
