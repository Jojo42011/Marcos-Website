---
// Multi-step intake form. Five quick questions so Marco arrives at the call
// already knowing your situation, plus name and contact so he can follow up.
// Posts to /api/lead.
import { smsHref } from '../config';
---
<form class="intake" data-intake novalidate>
  <!-- progress -->
  <div class="intake__progress" aria-hidden="true">
    <span class="intake__bar" data-progress style="--p:25%"></span>
  </div>

  <!-- Step 1: intent -->
  <fieldset class="intake__step" data-step="1">
    <legend class="intake__q">First things first, what brings you in?</legend>
    <div class="intake__choices">
      <label class="choice"><input type="radio" name="intent" value="buy" required /><span>I’m buying</span></label>
      <label class="choice"><input type="radio" name="intent" value="sell" /><span>I’m selling</span></label>
      <label class="choice"><input type="radio" name="intent" value="both" /><span>Both</span></label>
    </div>
  </fieldset>

  <!-- Step 2: price -->
  <fieldset class="intake__step" data-step="2" hidden>
    <legend class="intake__q">What price range feels comfortable?</legend>
    <div class="intake__choices intake__choices--stack">
      <label class="choice"><input type="radio" name="priceRange" value="Under $250k" required /><span>Under $250k</span></label>
      <label class="choice"><input type="radio" name="priceRange" value="$250k to $500k" /><span>$250k to $500k</span></label>
      <label class="choice"><input type="radio" name="priceRange" value="$500k to $1M" /><span>$500k to $1M</span></label>
      <label class="choice"><input type="radio" name="priceRange" value="$1M and up" /><span>$1M and up</span></label>
    </div>
  </fieldset>

  <!-- Step 3: timeline -->
  <fieldset class="intake__step" data-step="3" hidden>
    <legend class="intake__q">How soon are you looking to move?</legend>
    <div class="intake__choices intake__choices--stack">
      <label class="choice"><input type="radio" name="timeline" value="Within 60 days" required /><span>Within 60 days</span></label>
      <label class="choice"><input type="radio" name="timeline" value="2 to 6 months" /><span>2 to 6 months</span></label>
      <label class="choice"><input type="radio" name="timeline" value="Just exploring" /><span>Just exploring for now</span></label>
    </div>
  </fieldset>

  <!-- Step 4: lender -->
  <fieldset class="intake__step" data-step="4" hidden>
    <legend class="intake__q">If you are buying, have you talked to a lender yet?</legend>
    <div class="intake__choices intake__choices--stack">
      <label class="choice"><input type="radio" name="preApproved" value="Yes" required /><span>Yes, I am already approved with a lender</span></label>
      <label class="choice"><input type="radio" name="preApproved" value="Not yet" /><span>Not yet</span></label>
      <label class="choice"><input type="radio" name="preApproved" value="Selling only" /><span>Does not apply, I am selling</span></label>
    </div>
  </fieldset>

  <!-- Step 5: reason + contact -->
  <fieldset class="intake__step" data-step="5" hidden>
    <legend class="intake__q">Last one, why are you making this move?</legend>
    <textarea name="reason" rows="3" required placeholder="A sentence or two. A job change, a growing family, a first home, an investment. Whatever it is."></textarea>
    <div class="intake__row">
      <label class="field">
        <span>Your name</span>
        <input type="text" name="name" autocomplete="name" placeholder="First and last" />
      </label>
      <label class="field">
        <span>Best number or email</span>
        <input type="text" name="contact" autocomplete="tel" placeholder="So Marco can reach you" />
      </label>
    </div>
    <!-- honeypot: hidden from humans -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
      <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>
  </fieldset>

  <!-- nav -->
  <div class="intake__nav">
    <button type="button" class="intake__back" data-back hidden>Back</button>
    <button type="button" class="intake__next" data-next>Continue</button>
    <button type="submit" class="intake__submit" data-submit hidden>Send to Marco</button>
  </div>

  <p class="intake__step-label" data-step-label>Step 1 of 5</p>

  <!-- success / error states -->
  <div class="intake__done" data-done hidden>
    <div class="intake__done-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
    </div>
    <h3>Got it. Thanks for reaching out.</h3>
    <p>Marco reads every one of these himself and replies fast, usually within the hour. Want to skip the wait?</p>
    <a class="intake__done-text" href={smsHref('Hi Marco, I just filled out your form. ')}>Text him now</a>
  </div>

  <p class="intake__error" data-error hidden role="alert"></p>
</form>

<style>
  .intake {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.07);
  }
  .intake__progress {
    height: 4px;
    background: var(--gray-light);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .intake__bar {
    display: block; height: 100%; width: var(--p, 25%);
    background: var(--crimson);
    transition: width 0.45s var(--ease);
  }
  .intake__step { border: 0; margin: 0; padding: 0; }
  .intake__q {
    font-family: var(--font-head);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    padding: 0;
  }

  .intake__choices { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .intake__choices--stack { flex-direction: column; }
  .choice {
    position: relative;
    display: flex; align-items: center;
    flex: 1 1 auto; min-width: 140px;
    padding: 1rem 1.25rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 500;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .choice:hover { border-color: rgba(0,0,0,0.35); }
  .choice input { position: absolute; opacity: 0; }
  .choice:has(input:checked) {
    border-color: var(--crimson);
    background: rgba(153, 0, 0, 0.04);
    box-shadow: inset 0 0 0 1px var(--crimson);
  }
  .choice:has(input:focus-visible) { outline: 3px solid var(--crimson); outline-offset: 2px; }

  textarea, .field input {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--step-0);
    padding: 0.9rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    resize: vertical;
  }
  textarea:focus, .field input:focus { border-color: var(--crimson); outline: none; }
  .intake__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field span { font-size: 0.82rem; font-weight: 600; color: var(--muted); }

  .intake__nav { display: flex; align-items: center; gap: 0.75rem; margin-top: 2rem; }
  .intake__next, .intake__submit {
    margin-left: auto;
    background: var(--crimson); color: #fff;
    border: 0; border-radius: var(--radius);
    padding: 0.95rem 1.7rem;
    font-family: var(--font-body); font-weight: 600; font-size: var(--step-0);
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }
  .intake__next:hover, .intake__submit:hover { background: var(--crimson-hover); }
  .intake__back {
    background: none; border: 0;
    color: var(--muted); font-weight: 600; font-family: var(--font-body);
    cursor: pointer; padding: 0.5rem 0.25rem;
  }
  .intake__back:hover { color: var(--ink); }
  .intake__step-label { margin: 1rem 0 0; font-size: 0.8rem; color: var(--muted); text-align: right; }

  .intake__done { text-align: center; padding: 1rem 0; }
  .intake__done-mark {
    width: 62px; height: 62px; margin: 0 auto 1.25rem;
    display: grid; place-items: center;
    background: var(--crimson); color: #fff; border-radius: 50%;
  }
  .intake__done h3 { font-size: var(--step-2); }
  .intake__done p { color: var(--muted); max-width: 42ch; margin-inline: auto; }
  .intake__done-text {
    display: inline-block; margin-top: 0.5rem;
    color: var(--crimson); font-weight: 700; font-size: var(--step-1);
  }
  .intake__error {
    margin: 1rem 0 0; padding: 0.85rem 1rem;
    background: rgba(153,0,0,0.06); border: 1px solid rgba(153,0,0,0.25);
    border-radius: var(--radius); color: var(--crimson); font-size: 0.9rem; font-weight: 500;
  }

  @media (max-width: 520px) {
    .intake__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector('[data-intake]') as HTMLFormElement | null;
  if (form) {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.intake__step'));
    const bar = form.querySelector<HTMLElement>('[data-progress]');
    const backBtn = form.querySelector<HTMLButtonElement>('[data-back]');
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const stepLabel = form.querySelector<HTMLElement>('[data-step-label]');
    const doneEl = form.querySelector<HTMLElement>('[data-done]');
    const errEl = form.querySelector<HTMLElement>('[data-error]');
    const navEl = form.querySelector<HTMLElement>('.intake__nav');
    const total = steps.length;
    let current = 0;

    const render = () => {
      steps.forEach((s, i) => (s.hidden = i !== current));
      if (bar) bar.style.setProperty('--p', `${((current + 1) / total) * 100}%`);
      if (backBtn) backBtn.hidden = current === 0;
      const last = current === total - 1;
      if (nextBtn) nextBtn.hidden = last;
      if (submitBtn) submitBtn.hidden = !last;
      if (stepLabel) stepLabel.textContent = `Step ${current + 1} of ${total}`;
    };

    const stepValid = () => {
      const active = steps[current];
      const required = active.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]');
      for (const el of required) {
        if (el.type === 'radio') {
          const group = active.querySelectorAll<HTMLInputElement>(`[name="${el.name}"]`);
          if (![...group].some((r) => r.checked)) return false;
        } else if (!el.value.trim()) {
          return false;
        }
      }
      return true;
    };

    const showErr = (msg: string) => {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.hidden = false;
    };
    const clearErr = () => { if (errEl) errEl.hidden = true; };

    nextBtn?.addEventListener('click', () => {
      clearErr();
      if (!stepValid()) { showErr('Pick an option to keep going.'); return; }
      if (current < total - 1) { current++; render(); }
    });
    backBtn?.addEventListener('click', () => { clearErr(); if (current > 0) { current--; render(); } });

    // advance automatically after choosing a radio on single-choice steps
    steps.forEach((step) => {
      step.querySelectorAll('input[type="radio"]').forEach((r) => {
        r.addEventListener('change', () => {
          clearErr();
          if (current < total - 1) setTimeout(() => { current++; render(); }, 220);
        });
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErr();
      if (!stepValid()) { showErr('Add a quick note so Marco has context.'); return; }
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
      try {
        const res = await fetch('/api/lead', { method: 'POST', body: new FormData(form) });
        const out = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !out.ok) throw new Error(out.error || 'Failed');
        steps.forEach((s) => (s.hidden = true));
        navEl?.setAttribute('hidden', '');
        stepLabel?.setAttribute('hidden', '');
        if (bar) bar.style.setProperty('--p', '100%');
        if (doneEl) doneEl.hidden = false;
      } catch (err) {
        showErr(err instanceof Error && err.message !== 'Failed' ? err.message
          : "Couldn't send that. Text Marco directly and he'll take care of you.");
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send it to Marco'; }
      }
    });

    render();
  }
</script>
