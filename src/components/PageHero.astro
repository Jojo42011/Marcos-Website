---
// Compact hero for interior pages. Dark, cinematic, room to breathe.
// Accounts for the fixed overlay header, and can carry a ghost watermark
// word (ABOUT / CONTACT / …) behind the title.
interface Props {
  eyebrow: string;
  title: string;
  blurb?: string;
  watermark?: string;
}
const { eyebrow, title, blurb, watermark } = Astro.props;
---
<section class="phero">
  <div class="phero__bg" aria-hidden="true"></div>
  {watermark && <span class="wm wm--dark phero__wm" aria-hidden="true">{watermark}</span>}
  <div class="container phero__inner">
    <p class="label label--dark phero__label">{eyebrow}</p>
    <h1 class="phero__title">{title}</h1>
    {blurb && <p class="phero__blurb">{blurb}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    background: var(--obsidian);
    color: #fff;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .phero__bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(90% 120% at 85% 0%, rgba(153,0,0,0.35) 0%, transparent 55%),
      radial-gradient(70% 90% at 0% 100%, rgba(153,0,0,0.14) 0%, transparent 60%),
      #08080a;
  }
  .phero__bg::after {
    content: ''; position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(80% 70% at 50% 20%, #000, transparent 80%);
  }
  .phero__wm { top: auto; bottom: -0.15em; }
  .phero__inner { position: relative; z-index: 1; max-width: 780px; }
  .phero__title { font-size: var(--step-3); margin-bottom: 1rem; }
  .phero__blurb {
    font-size: var(--step-1);
    color: rgba(255,255,255,0.72);
    margin: 0;
    max-width: 60ch;
  }
</style>
