---
import { NAV, smsHref, SMS_DISPLAY } from '../config';

// Fixed header with the logo centered, per the luxury reference sites.
// Starts transparent over the dark hero (light links + light logo), then
// turns solid white with dark links once you scroll.
//
// Pages that open with a dark hero use the default overlay state. Pages
// that open on a light background (e.g. the contact form) pass `solid` so
// the header is solid from the first paint and its dark links stay legible.
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
const currentPath = Astro.url.pathname;
const leftNav = NAV.slice(0, 2);   // Buyers, Sellers
const rightNav = NAV.slice(2);     // About, Contact
---
<header class={`site-header${solid ? ' is-solid' : ''}`} data-header data-solid={solid ? 'true' : undefined}>
  <div class="site-header__inner container">
    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {leftNav.map((item) => (
        <a
          href={item.href}
          class="site-header__link"
          aria-current={currentPath === item.href ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <a href="/" class="site-header__logo" aria-label="Marco Puga Real Estate, home">
      <img class="site-header__logo-dark" src="/brand/logo.png" alt="Marco Puga Real Estate" width="215" height="210" />
      <img class="site-header__logo-light" src="/brand/logo-light.png" alt="" aria-hidden="true" width="215" height="210" />
    </a>

    <div class="site-header__nav site-header__nav--right">
      <nav class="site-header__nav-links" aria-label="Primary right">
        {rightNav.map((item) => (
          <a
            href={item.href}
            class="site-header__link"
            aria-current={currentPath === item.href ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
      <a href={smsHref()} class="site-header__sms">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
        <span>Text Marco</span>
      </a>
    </div>

    <button class="site-header__toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
      <span class="visually-hidden">Menu</span>
      <span class="site-header__bars" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav aria-label="Mobile">
      {NAV.map((item) => (
        <a href={item.href} class="mobile-nav__link">{item.label}</a>
      ))}
      <a href={smsHref()} class="mobile-nav__link mobile-nav__link--accent">Text {SMS_DISPLAY}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 90;
    background: transparent;
    transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .site-header.is-solid {
    background: var(--white);
    box-shadow: 0 1px 0 var(--line), 0 6px 24px rgba(0, 0, 0, 0.05);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .site-header__nav { display: flex; align-items: center; gap: 2rem; }
  .site-header__nav--left { justify-content: flex-start; }
  .site-header__nav--right { justify-content: flex-end; }
  .site-header__nav-links { display: flex; align-items: center; gap: 2rem; }

  .site-header__link {
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--white);
    position: relative;
    padding-block: 0.4rem;
    transition: color var(--dur) var(--ease);
  }
  .site-header.is-solid .site-header__link { color: var(--ink); }
  .site-header__link::after {
    content: '';
    position: absolute; left: 0; bottom: 0;
    width: 100%; height: 1.5px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .site-header__link:hover::after,
  .site-header__link[aria-current='page']::after { transform: scaleX(1); }

  /* Centered logo: both variants rendered, the header state picks one */
  .site-header__logo { display: inline-flex; line-height: 0; }
  .site-header__logo img {
    height: 74px;
    width: auto;
    display: block;
    transition: opacity var(--dur) var(--ease);
  }
  .site-header__logo img.site-header__logo-dark { display: none; }
  .site-header.is-solid .site-header__logo img.site-header__logo-dark { display: block; }
  .site-header.is-solid .site-header__logo img.site-header__logo-light { display: none; }

  .site-header__sms {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 2px;
    padding: 0.65rem 1.15rem;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .site-header__sms:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--white); }
  .site-header.is-solid .site-header__sms {
    color: var(--white);
    background: var(--crimson);
    border-color: var(--crimson);
  }
  .site-header.is-solid .site-header__sms:hover { background: var(--crimson-hover); border-color: var(--crimson-hover); }

  .site-header__toggle {
    display: none;
    background: none; border: 0; cursor: pointer;
    width: 44px; height: 44px; padding: 0;
    position: relative; color: var(--white);
    grid-column: 3;
    justify-self: end;
    transition: color var(--dur) var(--ease);
  }
  .site-header.is-solid .site-header__toggle { color: var(--ink); }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
    left: 10px; width: 24px; height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.2s;
  }
  .site-header__bars { top: 21px; }
  .site-header__bars::before { top: -7px; }
  .site-header__bars::after { top: 7px; }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--white);
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .mobile-nav[data-open] { display: block; }
  .mobile-nav nav { display: flex; flex-direction: column; }
  .mobile-nav__link {
    padding: 0.95rem 0;
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .mobile-nav__link--accent { color: var(--crimson); font-weight: 700; border-bottom: 0; }

  @media (max-width: 900px) {
    .site-header__nav--left,
    .site-header__nav--right { display: none; }
    .site-header__inner { grid-template-columns: 44px 1fr 44px; }
    .site-header__logo { grid-column: 2; justify-self: center; }
    .site-header__logo img { height: 58px; }
    .site-header__toggle { display: block; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const drawer = document.querySelector('[data-mobile-nav]');

  // Pages that open on a light background force the solid state from load.
  const forcedSolid = header?.getAttribute('data-solid') === 'true';
  const drawerOpen = () => drawer?.hasAttribute('data-open');
  const sync = () => {
    if (!header) return;
    header.classList.toggle('is-solid', forcedSolid || window.scrollY > 40 || !!drawerOpen());
  };
  sync();
  window.addEventListener('scroll', sync, { passive: true });

  toggle?.addEventListener('click', () => {
    if (drawerOpen()) {
      drawer?.removeAttribute('data-open');
      drawer?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      drawer?.setAttribute('data-open', '');
      drawer?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
    sync();
  });
</script>
