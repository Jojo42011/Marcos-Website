---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV, smsHref } from '../config';

// Transparent over dark heroes, solid on scroll. `tone` sets the initial
// (pre-scroll) color scheme for the page it sits on.
interface Props { tone?: 'dark' | 'light'; }
const { tone = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<header class={`site-header site-header--${tone}`} data-header>
  <div class="site-header__inner container">
    <Logo variant="lockup" tone={tone === 'dark' ? 'light' : 'dark'} class="site-header__logo" />

    <nav class="site-header__nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="site-header__link"
          aria-current={currentPath === item.href ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="site-header__cta">
      <Button href={smsHref()} variant="primary" dataSms={true} class="site-header__text">Text Marco</Button>
    </div>

    <button class="site-header__toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
      <span class="visually-hidden">Menu</span>
      <span class="site-header__bars" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav aria-label="Mobile">
      {NAV.map((item) => (
        <a href={item.href} class="mobile-nav__link">{item.label}</a>
      ))}
      <a href="/contact" class="mobile-nav__link mobile-nav__link--accent">Book a 15-min call</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    background: transparent;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 74px;
  }

  .site-header__nav { display: flex; gap: 2rem; margin-left: auto; margin-right: 2rem; }
  .site-header__link {
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
    padding-block: 0.4rem;
    transition: color 0.3s var(--ease);
  }
  .site-header__link::after {
    content: '';
    position: absolute; left: 0; bottom: 0;
    width: 100%; height: 1.5px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .site-header__link:hover::after,
  .site-header__link[aria-current='page']::after { transform: scaleX(1); }

  /* Tone: dark page (transparent header over dark hero) */
  .site-header--dark .site-header__link { color: rgba(255, 255, 255, 0.82); }
  .site-header--dark .site-header__link:hover { color: #fff; }

  /* Tone: light page */
  .site-header--light .site-header__link { color: var(--ink); }

  /* Scrolled state — solid white, dark text, applied via JS */
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    box-shadow: 0 1px 0 var(--line);
  }
  /* Solid-white header → force the mark + wordmark dark. !important beats the
     Logo component's own scoped .logo--light rules (higher specificity). */
  .site-header.is-scrolled :global(.logo__name) { color: var(--ink) !important; }
  .site-header.is-scrolled :global(.logo__role) { color: var(--crimson) !important; }
  .site-header.is-scrolled .site-header__link { color: var(--ink); }
  .site-header.is-scrolled :global(.logo__mark path:first-of-type) { stroke: var(--ink); }

  .site-header__toggle {
    display: none;
    background: none; border: 0; cursor: pointer;
    width: 44px; height: 44px; padding: 0;
    position: relative;
  }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
    left: 10px; width: 24px; height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.2s;
  }
  .site-header__bars { top: 21px; }
  .site-header__bars::before { top: -7px; }
  .site-header__bars::after { top: 7px; }
  .site-header--dark .site-header__toggle { color: #fff; }
  .site-header--light .site-header__toggle,
  .site-header.is-scrolled .site-header__toggle { color: var(--ink); }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--white);
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .mobile-nav[data-open] { display: block; }
  .mobile-nav nav { display: flex; flex-direction: column; }
  .mobile-nav__link {
    padding: 0.95rem 0;
    font-weight: 500;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .mobile-nav__link--accent { color: var(--crimson); font-weight: 600; border-bottom: 0; }

  @media (max-width: 820px) {
    .site-header__nav,
    .site-header__cta { display: none; }
    .site-header__toggle { display: block; margin-left: auto; }
    /* mobile header always solid for legibility */
    .site-header { background: rgba(255, 255, 255, 0.96); box-shadow: 0 1px 0 var(--line); }
    .site-header :global(.logo__name) { color: var(--ink) !important; }
    .site-header :global(.logo__role) { color: var(--crimson) !important; }
    .site-header :global(.logo__mark path:first-of-type) { stroke: var(--ink); }
    .site-header__toggle { color: var(--ink); }
    .site-header--dark .site-header__toggle { color: var(--ink); }
  }
</style>

<script>
  // Solidify header after scrolling past the hero.
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 40);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile drawer toggle.
  const toggle = document.querySelector('[data-nav-toggle]');
  const drawer = document.querySelector('[data-mobile-nav]');
  toggle?.addEventListener('click', () => {
    const open = drawer?.hasAttribute('data-open');
    if (open) {
      drawer?.removeAttribute('data-open');
      drawer?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      drawer?.setAttribute('data-open', '');
      drawer?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>
