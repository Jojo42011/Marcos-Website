---
import Button from './Button.astro';

// Featured Listings — live from the MLS (SimplyRETS / SABOR feed).
//
// The homepage stays prerendered and instant: the section server-renders a
// row of dark placeholder cards, then a small script fetches /api/listings
// (CDN-cached JSON) and fills them in — Marco's own listings first, topped up
// with fresh premium San Antonio area homes. If the feed is unreachable the
// whole section quietly hides, so nothing ever looks broken.
interface Props {
  heading?: string;
  eyebrow?: string;
  blurb?: string;
}
const {
  heading = 'Homes On The Market Now.',
  eyebrow = 'Featured listings',
  blurb = 'Live from the MLS. Marco’s own listings plus fresh homes across the San Antonio area, updated throughout the day.',
} = Astro.props;

const CARD_COUNT = 10;
---
<section class="listings section" aria-labelledby="listings-h" data-listings hidden>
  <span class="wm" aria-hidden="true">HOMES</span>
  <div class="container listings__container">
    <div class="listings__head" data-reveal>
      <div class="listings__intro">
        <p class="label">{eyebrow}</p>
        <h2 id="listings-h">{heading}</h2>
        <p class="listings__blurb">{blurb}</p>
      </div>
      <div class="listings__nav">
        <button type="button" class="listings__arrow" data-listings-prev aria-label="Previous listings">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="listings__arrow" data-listings-next aria-label="Next listings">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="listings__track" data-listings-track>
    {Array.from({ length: CARD_COUNT }).map((_, i) => (
      <article class="lcard" data-reveal data-lcard style={`--i:${i}`}>
        <div class="lcard__ph" aria-hidden="true"><span>Marco Puga</span></div>
        <img class="lcard__img" alt="" loading="lazy" decoding="async" hidden />
        <div class="lcard__scrim" aria-hidden="true"></div>
        <span class="lcard__badge" data-badge hidden></span>
        <div class="lcard__meta">
          <p class="lcard__price" data-price></p>
          <p class="lcard__addr" data-addr></p>
          <p class="lcard__specs" data-specs></p>
          <p class="lcard__mls" data-office></p>
        </div>
        <a class="lcard__cover" data-cover href="/listings" tabindex="-1" aria-hidden="true"></a>
        <a class="lcard__view" data-view href="/listings">View</a>
      </article>
    ))}
  </div>

  <div class="container listings__all" data-reveal>
    <Button href="/listings" variant="outline">View All Listings</Button>
  </div>
</section>

<style>
  .listings { position: relative; background: var(--white); overflow: hidden; }
  .listings__container { position: relative; z-index: 1; }

  .listings__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
    flex-wrap: wrap;
  }
  .listings__intro { max-width: 640px; }
  .listings__blurb { color: var(--muted); font-size: var(--step-1); margin: 0; }

  .listings__nav { display: flex; gap: 0.65rem; }
  .listings__arrow {
    width: 54px; height: 54px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.25);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    display: grid; place-items: center;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .listings__arrow:hover { border-color: var(--crimson); background: var(--crimson); color: #fff; }

  /* Scroll track sits at container width so cards flow past the right edge. */
  .listings__track {
    position: relative;
    z-index: 1;
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: 0.5rem;
  }
  .listings__track::-webkit-scrollbar { display: none; }

  .lcard {
    flex: 0 0 clamp(280px, 80vw, 380px);
    scroll-snap-align: start;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0b0b0c;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.10);
    transition-delay: calc(var(--i) * 60ms);
  }
  .lcard__img,
  .lcard__ph {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .lcard__img { opacity: 0; transition: opacity 0.6s var(--ease); }
  .lcard__img.is-loaded { opacity: 1; }
  .lcard__ph {
    display: grid; place-items: center;
    background: radial-gradient(120% 100% at 30% 0%, #1a1a1d 0%, #050506 70%);
  }
  .lcard__ph::after {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent);
  }
  .lcard__ph span {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.28);
  }
  .lcard__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 32%, transparent 62%);
    pointer-events: none;
  }
  .lcard__badge {
    position: absolute;
    top: 1rem; left: 1rem;
    z-index: 2;
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: var(--crimson);
    border-radius: 2px;
    padding: 0.4rem 0.7rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .lcard__badge--new { background: rgba(11, 11, 12, 0.82); }
  .lcard__meta {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.25rem 1.4rem;
    color: #fff;
    pointer-events: none;
  }
  .lcard__price {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1;
    margin: 0 0 0.55rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
  .lcard__addr {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
  }
  .lcard__specs {
    font-size: 0.82rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
  }
  .lcard__mls {
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.55);
    margin: 0.45rem 0 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .lcard__cover { position: absolute; inset: 0; z-index: 1; }
  .lcard__view {
    position: absolute;
    right: 1.1rem; bottom: 1.2rem;
    z-index: 2;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius);
    background: var(--crimson);
    color: #fff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
    transition: background 0.25s var(--ease);
  }
  .lcard__view:hover { background: var(--crimson-hover); }

  .listings__all {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }
</style>

<script>
  // 1) Arrow nav: scroll the track by one card + gap. Touch/trackpad users
  //    just swipe the overflow-scroll track directly.
  document.querySelectorAll<HTMLElement>('[data-listings]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-listings-track]');
    if (!track) return;
    const scrollByCard = (dir: number) => {
      const card = track.querySelector<HTMLElement>('.lcard');
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 20;
      const step = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.85;
      track.scrollBy({ left: dir * step, behavior: 'smooth' });
    };
    section.querySelector('[data-listings-prev]')?.addEventListener('click', () => scrollByCard(-1));
    section.querySelector('[data-listings-next]')?.addEventListener('click', () => scrollByCard(1));
  });

  // 2) Fill the placeholder cards with live MLS data. The section starts
  //    hidden and only appears once real listings are in hand.
  interface FeaturedCard {
    mlsId: number;
    price: string;
    address: string;
    specs: string;
    photo: string | null;
    href: string;
    isMarco: boolean;
    isNew: boolean;
    office: string | null;
  }

  (async () => {
    const section = document.querySelector<HTMLElement>('[data-listings]');
    if (!section) return;
    try {
      const res = await fetch('/api/listings');
      if (!res.ok) throw new Error(String(res.status));
      const data: { ok: boolean; listings?: FeaturedCard[] } = await res.json();
      const listings = data.ok && data.listings ? data.listings.filter((l) => l.photo) : [];
      if (!listings.length) return; // stays hidden

      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-lcard]'));
      cards.forEach((card, i) => {
        const l = listings[i];
        if (!l) { card.remove(); return; }

        const img = card.querySelector<HTMLImageElement>('.lcard__img');
        if (img && l.photo) {
          img.src = l.photo;
          img.alt = l.address;
          img.hidden = false;
          img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
        }
        const set = (sel: string, text: string) => {
          const el = card.querySelector<HTMLElement>(sel);
          if (el) el.textContent = text;
        };
        set('[data-price]', l.price);
        set('[data-addr]', l.address);
        set('[data-specs]', l.specs);
        set('[data-office]', l.isMarco ? 'Listed by Marco Puga, eXp Realty' : (l.office ? `Courtesy of ${l.office}` : ''));

        const badge = card.querySelector<HTMLElement>('[data-badge]');
        if (badge && (l.isMarco || l.isNew)) {
          badge.textContent = l.isMarco ? 'Marco’s Listing' : 'New';
          badge.classList.toggle('lcard__badge--new', !l.isMarco);
          badge.hidden = false;
        }
        card.querySelectorAll<HTMLAnchorElement>('[data-view], [data-cover]').forEach((a) => {
          a.href = l.href;
        });
        const view = card.querySelector<HTMLAnchorElement>('[data-view]');
        if (view) view.setAttribute('aria-label', `View ${l.address}`);
      });

      section.hidden = false;
      // Cards render inside an already-observed page: re-trigger reveal.
      section.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
    } catch {
      /* feed unavailable — section stays hidden, page looks intentional */
    }
  })();
</script>
